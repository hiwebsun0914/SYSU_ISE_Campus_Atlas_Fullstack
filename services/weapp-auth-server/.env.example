# Node service
PORT=3000
JWT_SECRET=replace-with-a-long-random-string
JWT_CLOCK_SKEW=5
VERIFY_LAST_TOKEN=false

# Optional: use a custom location for users.json
# USERS_FILE=/absolute/path/to/users.json

# Private future-card storage and moderation. Keep the production dictionary outside source control.
# FUTURE_CARDS_FILE=/absolute/path/to/future_cards.json
# SENSITIVE_WORDS_FILE=/absolute/path/to/sensitive_words.txt
# SENSITIVE_WORDS=example-word-one,example-word-two
FUTURE_CARD_WRITE_LIMIT=30
FUTURE_CARD_BODY_LIMIT=16384
FUTURE_CARD_IMAGE_LIMIT=8388608

# Tencent Cloud Object Storage (needed for avatar/check-in/future-card image uploads)
COS_BUCKET=sysuzngcxy-1322240898
COS_REGION=ap-guangzhou
PUBLIC_ASSET_DOMAIN=https://sysuzngcxy-1322240898.cos.ap-guangzhou.myqcloud.com

# Some routes use COS_* names; others use TENCENT_* names.
# Until the server code is unified, set both pairs to the same credentials.
COS_SECRET_ID=replace-me
COS_SECRET_KEY=replace-me
TENCENT_SECRET_ID=replace-me
TENCENT_SECRET_KEY=replace-me
STS_DURATION=300
